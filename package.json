{
  "name": "mat2-sps-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "MAT2 SPS 3D simulator - AWL (STL) S7 emulator with a 3D model railway plant (TU Dresden Praktikum)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"tools/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "gates": "npm run typecheck && npm run lint && npm run test && npm run build",
    "release-check": "npm run build && node tools/release-check.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/lint": "^6.8.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/three": "^0.180.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.2.0"
  }
}
